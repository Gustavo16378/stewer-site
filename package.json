{
  "name": "stewer-gabriel",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p functions && vite build",
    "preview": "vite preview",
    "og:image": "node scripts/generate-og-image.mjs",
    "seed": "tsx scripts/gerar-seed.ts",
    "dev:api": "npm run build && wrangler pages dev dist",
    "db:local": "wrangler d1 migrations apply stewer-site --local",
    "db:remoto": "wrangler d1 migrations apply stewer-site --remote",
    "admin": "node scripts/criar-admin.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:api": "vitest run --project api",
    "test:seguranca": "vitest run --project api tests/seguranca && playwright test tests/e2e/seguranca.spec.ts",
    "test:desempenho": "vitest run --project desempenho && playwright test tests/e2e/desempenho.spec.ts",
    "test:carga": "node tests/carga/carga.mjs",
    "test:e2e": "playwright test",
    "test:tudo": "npm run build && vitest run && playwright test",
    "test:cobertura": "vitest run --project unit --coverage",
    "auditoria": "npm audit --omit=dev && npm audit --audit-level=high",
    "docs:pdf": "node scripts/gerar-pdfs.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "gsap": "^3.15.1",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261108.1",
    "@playwright/test": "^1.65.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.4.20",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0",
    "parse5": "^7.3.0",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.4.47",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0",
    "zod": "^4.6.7"
  }
}
